snippet doc "HTML document structure" b
<!DOCTYPE html>
<html>
<head>
	<title>${1:Title}</title>
</head>
<body>
	$0
</body>
</html>
endsnippet

snippet div "Div with class" w
<div class="${1:container}">
	$0
</div>
endsnippet

snippet input "Input element" w
<input type="${1:text}" class="${2:}" placeholder="${3:}" />$0
endsnippet

snippet btn "Button element" w
<button class="${1:btn}">${2:Click me}</button>$0
endsnippet

snippet form "Form element" b
<form action="${1:#}" method="${2:POST}">
	$0
</form>
endsnippet
