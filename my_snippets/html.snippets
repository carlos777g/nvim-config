snippet html5 "HTML5 basic template" b
<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>${1:Page Title}</title>
	<style>
		${2:/* Your CSS here */}
	</style>
</head>
<body>
	${3:<h1>Welcome</h1>}
	<script>
		${4:// Your JavaScript here}
	</script>
</body>
</html>
endsnippet

snippet html:5 "HTML5 basic template" b
<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>${1:Page Title}</title>
