snippet html5 "HTML5 basic template" b
<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>${1:Page Title}</title>
	<style>
		${2:/* Your CSS here */}
	</style>
</head>
<body>
	${3:<h1>Welcome</h1>}
	<script>
		${4:// Your JavaScript here}
	</script>
</body>
</html>
endsnippet

snippet html:5 "HTML5 basic template" b
<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>${1:Page Title}</title>
	<style>
		${2:/* Your CSS here */}
	</style>
</head>
<body>
	${3:<h1>Welcome</h1>}
	<script>
		${4:// Your JavaScript here}
	</script>
</body>
</html>
endsnippet

snippet doc "HTML document structure" b
<!DOCTYPE html>
<html>
<head>
	<title>${1:Title}</title>
</head>
<body>
	$0
</body>
</html>
endsnippet

snippet div "Div with class" w
<div class="${1:container}">
	$0
</div>
endsnippet

snippet input "Input element" w
<input type="${1:text}" class="${2:}" placeholder="${3:}" />$0
endsnippet

snippet btn "Button element" w
<button class="${1:btn}">${2:Click me}</button>$0
endsnippet

snippet form "Form element" b
<form action="${1:#}" method="${2:POST}">
	$0
</form>
endsnippet

# Quick tag snippets (one-liners)
snippet h1 "Heading 1" w
<h1>$1</h1>$0
endsnippet

snippet h2 "Heading 2" w
<h2>$1</h2>$0
endsnippet

snippet h3 "Heading 3" w
<h3>$1</h3>$0
endsnippet

snippet h4 "Heading 4" w
<h4>$1</h4>$0
endsnippet

snippet h5 "Heading 5" w
<h5>$1</h5>$0
endsnippet

snippet h6 "Heading 6" w
<h6>$1</h6>$0
endsnippet

snippet p "Paragraph" w
<p>$1</p>$0
endsnippet

snippet span "Span element" w
<span>$1</span>$0
endsnippet

snippet a "Link" w
<a href="${1:#}">$2</a>$0
endsnippet

snippet img "Image" w
<img src="${1:}" alt="${2:}" />$0
endsnippet

snippet ul "Unordered list" b
<ul>
	<li>$1</li>
</ul>$0
endsnippet

snippet ol "Ordered list" b
<ol>
	<li>$1</li>
</ol>$0
endsnippet

snippet li "List item" w
<li>$1</li>$0
endsnippet

snippet table "Table element" b
<table>
	<tr>
		<td>$1</td>
	</tr>
</table>$0
endsnippet

snippet tr "Table row" w
<tr>$1</tr>$0
endsnippet

snippet td "Table data" w
<td>$1</td>$0
endsnippet

snippet label "Label element" w
<label for="${1:}">$2</label>$0
endsnippet

snippet section "Section element" b
<section>
	$0
</section>
endsnippet

snippet article "Article element" b
<article>
	$0
</article>
endsnippet

snippet nav "Navigation element" b
<nav>
	$0
</nav>
endsnippet

snippet header "Header element" b
<header>
	$0
</header>
endsnippet

snippet footer "Footer element" b
<footer>
	$0
</footer>
endsnippet
